# Patient data + generated outputs — never commit (may contain PHI)
patient_case.txt
matches_output.md
referrals.csv
referral_events.csv
referrals/

# Web app: local DB (contains patient notes + accounts), secret, venv.
# Catch every SQLite file/sidecar in any directory so a stray DB (e.g. created
# by running a script from the wrong cwd) can never be committed - may hold PHI.
*.db
*.db-shm
*.db-wal
*.db-journal
web/bridgemd.db
web/bridgemd.db-shm
web/bridgemd.db-wal
web/bridgemd.db-journal
web/.secret
# Local secrets (API keys, SMTP creds) — never commit
secrets.env
web/secrets.env
.env
web/.env
.venv/
__pycache__/

# Uploaded documents (candidate-thread + team-room files) — runtime data,
# may contain PHI. The directory is auto-created by the app on startup.
web/uploads/

# Search-quality benchmark runtime output (regenerated on each run)
web/search_eval_log.jsonl
web/search_eval_state.json
